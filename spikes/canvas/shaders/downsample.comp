#version 440
// One mip level of the projection (IMG-032): reads level k-1 (a separate, sampled texture) and
// writes level k (another texture) with a 2x2 box filter. Edge texels are clamped, like
// cpu_downsample in rust/src/cpu_composite.rs. Only the dirty region is dispatched.
layout(local_size_x = 16, local_size_y = 16) in;

layout(std140, binding = 0) uniform Params {
    ivec4 sizes;   // xy = source size, zw = destination size
    ivec4 region;  // xy = destination origin, zw = destination extent
};
layout(binding = 1) uniform sampler2D src;
layout(binding = 2, rgba8) uniform writeonly image2D dst;

void main()
{
    ivec2 d = region.xy + ivec2(gl_GlobalInvocationID.xy);
    if (gl_GlobalInvocationID.x >= uint(region.z) || gl_GlobalInvocationID.y >= uint(region.w)
        || d.x >= sizes.z || d.y >= sizes.w)
        return;
    ivec2 last = sizes.xy - 1;
    ivec2 s0 = min(2 * d, last);
    ivec2 s1 = min(2 * d + 1, last);
    vec4 sum = texelFetch(src, s0, 0) + texelFetch(src, ivec2(s1.x, s0.y), 0)
             + texelFetch(src, ivec2(s0.x, s1.y), 0) + texelFetch(src, s1, 0);
    imageStore(dst, d, sum * 0.25);
}
