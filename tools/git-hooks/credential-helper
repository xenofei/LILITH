#!/bin/sh
# Git's credential helper for this repository (QA-079, ruling R28): see
# crates/ww-cli/src/dev/agent_access.rs. `ww dev install-hooks` writes the entry that runs it.
#
# It runs the CLI crate this checkout has: `lil-cli` after the LILITH rename, `ww-cli` before
# it. Every worktree of a clone shares the one `.git/config` entry, and each runs its own copy
# of this script, so the entry keeps working across the rename.
#
# Git appends the action (get, store, erase) and writes its request on stdin; both pass
# straight through. Stdout is git's credential protocol: only the CLI's answer goes there, and
# this script's own messages go to stderr. The token is never printed or logged here.

# Helpers can run with a PATH that lacks cargo (a GUI client, an IDE): look in the usual place.
if ! command -v cargo >/dev/null 2>&1; then
    PATH="$HOME/.cargo/bin:$PATH"
    export PATH
    if ! command -v cargo >/dev/null 2>&1; then
        echo "credential-helper: cargo wasn't found on PATH or in \$HOME/.cargo/bin, so no credential was given" >&2
        exit 1
    fi
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

if [ -f crates/lil-cli/Cargo.toml ]; then
    exec cargo run -q --locked -p lil-cli --bin lil -- dev git-credential "$@"
elif [ -f crates/ww-cli/Cargo.toml ]; then
    exec cargo run -q --locked -p ww-cli --bin ww -- dev git-credential "$@"
fi

echo "credential-helper: this checkout has no CLI crate" >&2
exit 1
