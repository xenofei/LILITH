{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.lil_path}",
            "args": ["hook", "session-start"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|mcp__comfyui__.*",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.lil_path}",
            "args": ["hook", "pre-tool-use"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.lil_path}",
            "args": ["hook", "post-tool-use"]
          }
        ]
      }
    ]
  }
}
